# ------------------------------------------------------------------------------
# This is an example .env file.
#
# All of these environment vars must be defined either in your environment or in
# a local .env file in order to run this app.
#
# @see https://github.com/rolodato/dotenv-safe for more details.
# ------------------------------------------------------------------------------

# Optional (for fathom analytics)
#NEXT_PUBLIC_FATHOM_ID=

# Optional (for PostHog analytics)
#NEXT_PUBLIC_POSTHOG_ID=

# Optional (for rendering tweets more efficiently)
#TWITTER_ACCESS_TOKEN=

# Optional (for persisting preview images to redis)
# NOTE: set isRedisEnabled to true in site.config.ts for preview image cache only
#REDIS_HOST=
#REDIS_PASSWORD=
#REDIS_USER='default'
#REDIS_NAMESPACE='preview-images'

# Likes, views, comments (Vercel Postgres / Neon — auto-set via Storage → Postgres)
#POSTGRES_URL=

# Shared Guardian Circle backend authentication (server-only).
# Defaults: production -> api.azaira.bg; Vercel Preview / local -> api-staging.azaira.bg.
# Set explicitly if a preview should use another backend; never use NEXT_PUBLIC_ here.
#GC_API_URL=https://api-staging.azaira.bg/api
#GC_SITE_URL=https://test.guardiancircle.bg
